{
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultTools": ["+codemode"],
  "packages": [
    "npm:@dietrichgebert/ponytail",
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:@tryinget/pi-telemetry",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/Alan-Luc/coordinate",
    "git:github.com/Alan-Luc/pi-subagents",
    "git:github.com/Alan-Luc/pi-permission-system",
    "git:github.com/Alan-Luc/pi-cc-extensions",
    "git:github.com/Alan-Luc/pi-tasks",
    "git:github.com/Alan-Luc/pi-vim",
    "git:github.com/alan-luc/pi-inspect-change@main",
    "git:github.com/Alan-Luc/pi-inspect-context@main",
    "git:github.com/Alan-Luc/pi-background-tasks@main"
  ],
  "quietStartup": true,
  "steeringMode": "one-at-a-time",
  "theme": "kanagawa-ink",
  "fullscreenCopyOnSelect": true,
  "tuiMode": "fullscreen",
  "modelThinkingLevels": {
    "deepseek/deepseek-flash": "low"
  },
  "hideThinkingBlock": true,
  "showHardwareCursor": true
}
